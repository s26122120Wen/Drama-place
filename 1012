            background-attachment: fixed;
            min-height: 100vh;
        }

        /* 酷炫光影與 Hover 特效 */
        .unlocked-card {
            position: relative;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(8px);
        }

        .unlocked-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(
                90deg,
                transparent,
                rgba(255, 255, 255, 0.6),
                transparent
            );
            transition: 0.6s;
        }

        .unlocked-card:hover::before {
            left: 100%;
        }

        .unlocked-card:hover {
            transform: translateY(-6px) scale(1.02);
            box-shadow: 0 16px 28px -8px rgba(71, 102, 74, 0.18), 0 6px 12px -4px rgba(0, 0, 0, 0.04);
            border-color: #7c9d7f;
        }

        .locked-card {
            background: rgba(240, 243, 240, 0.6);
            backdrop-filter: blur(4px);
            transition: all 0.3s ease;
        }

        .locked-card:hover {
            transform: translateY(-2px);
            background: rgba(235, 239, 235, 0.8);
        }

        /* 動態脈衝波光圈 */
        @keyframes subtle-pulse {
            0%, 100% { transform: scale(1); opacity: 0.3; }
            50% { transform: scale(1.08); opacity: 0.6; }
        }

        .avatar-pulse {
            animation: subtle-pulse 4s infinite ease-in-out;
        }

        /* 進度條閃光動畫 */
        @keyframes shimmer {
            0% { background-position: -200% 0; }
            100% { background-position: 200% 0; }
        }

        .progress-shimmer {
            background: linear-gradient(90deg, #5c8060 25%, #a3bba5 50%, #5c8060 75%);
            background-size: 200% 100%;
            animation: shimmer 3s infinite;
        }
    </style>
