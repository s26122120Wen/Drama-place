        /* 頁面背景與基本設定 */
        body {
            background-color: #f5f7f5;
            color: #2c3531;
            font-family: 'Outfit', 'Noto Sans TC', sans-serif;
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(163, 187, 165, 0.15) 0%, transparent 40%),
